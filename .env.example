# Runtime
CODEBASEOS_ENVIRONMENT=development
CODEBASEOS_DATABASE_URL=sqlite:///./codebaseos.db
CODEBASEOS_RETENTION_DAYS=90
CODEBASEOS_MAX_FILE_BYTES=1000000

# Supabase
CODEBASEOS_SUPABASE_URL=
CODEBASEOS_SUPABASE_PROJECT_ID=
CODEBASEOS_SUPABASE_PUBLISHABLE_KEY=

# GitHub App
# Create at: https://github.com/settings/apps
CODEBASEOS_GITHUB_APP_ID=
CODEBASEOS_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
CODEBASEOS_GITHUB_WEBHOOK_SECRET=
CODEBASEOS_GITHUB_CLIENT_ID=
CODEBASEOS_GITHUB_CLIENT_SECRET=
CODEBASEOS_GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# Model gateway
# Supported values: none, openai, groq, cerebras, together, openrouter, openai-compatible, anthropic, gemini
CODEBASEOS_MODEL_PROVIDER=none
CODEBASEOS_MODEL_API_KEY=
CODEBASEOS_MODEL_NAME=
CODEBASEOS_MODEL_BASE_URL=

# Object storage
CODEBASEOS_OBJECT_STORAGE_PROVIDER=local
CODEBASEOS_OBJECT_STORAGE_BUCKET=codebaseos-snapshots
CODEBASEOS_OBJECT_STORAGE_ENDPOINT=
CODEBASEOS_OBJECT_STORAGE_ACCESS_KEY=
CODEBASEOS_OBJECT_STORAGE_SECRET_KEY=

# Authentication
CODEBASEOS_AUTH_PROVIDER=github
CODEBASEOS_SESSION_SECRET=replace-with-a-long-random-value
